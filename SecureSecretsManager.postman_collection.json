{
  "info": {
    "name": "Secure Secrets Manager",
    "description": "Full API collection for the Secure Secrets Manager Flask application.\n\n**Quick start:**\n1. Import this collection and the accompanying environment file.\n2. Run **Register** then **Login** — the Login request automatically stores the JWT in the `token` collection variable.\n3. All authenticated requests pick up the token from that variable automatically.\n4. Run **Store a Secret** to get a `secret_id`, then explore the rest of the endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Base URL of the running Flask server"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT — populated automatically by the Login request"
    },
    {
      "key": "secret_id",
      "value": "",
      "type": "string",
      "description": "Secret UUID — populate after creating a secret"
    },
    {
      "key": "share_token",
      "value": "",
      "type": "string",
      "description": "One-time share token — populated automatically by the Share request"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "User registration and login. No JWT required.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"supersecret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Create a new user account.\n\n**Validation rules:**\n- `username` — 3–64 characters, must be unique\n- `password` — minimum 8 characters"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"User registered\",\n  \"user\": {\n    \"id\": \"a1b2c3d4-0000-0000-0000-000000000001\",\n    \"username\": \"alice\",\n    \"created_at\": \"2026-05-22T10:00:00+00:00\"\n  }\n}"
            },
            {
              "name": "409 Conflict — duplicate username",
              "status": "Conflict",
              "code": 409,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Username already exists\"\n}"
            },
            {
              "name": "400 Bad Request — weak password",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"password must be at least 8 characters\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    console.log('JWT saved to collection variable: token');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"supersecret123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Authenticate and receive a JWT.\n\nThe **Tests** script automatically saves the returned token into the `token` collection variable so that all subsequent authenticated requests work without manual copy-paste."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhMWIyYzNkNC0uLi4ifQ.sig\"\n}"
            },
            {
              "name": "401 Unauthorized — bad credentials",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Invalid credentials\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Secrets",
      "description": "Create, list, retrieve, update, and delete secrets.\n\nAll requests require `Authorization: Bearer {{token}}`.",
      "item": [
        {
          "name": "Store a Secret",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.secret && json.secret.id) {",
                  "    pm.collectionVariables.set('secret_id', json.secret.id);",
                  "    console.log('secret_id saved: ' + json.secret.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/secrets",
              "host": ["{{base_url}}"],
              "path": ["secrets"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"STRIPE_API_KEY\",\n  \"value\": \"sk_live_abc123xyz\",\n  \"description\": \"Production Stripe secret key\",\n  \"tags\": [\"payments\", \"production\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Encrypt and store a new secret.\n\nThe `value` field is encrypted with Fernet before being written to disk — it is **never stored in plaintext**.\n\nThe response omits `value`; use **Retrieve a Secret** to read it back.\n\nThe Tests script saves the new `secret_id` to the collection variable automatically."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Secret stored\",\n  \"secret\": {\n    \"id\": \"f7e6d5c4-0000-0000-0000-000000000002\",\n    \"owner_id\": \"a1b2c3d4-0000-0000-0000-000000000001\",\n    \"name\": \"STRIPE_API_KEY\",\n    \"description\": \"Production Stripe secret key\",\n    \"tags\": [\"payments\", \"production\"],\n    \"created_at\": \"2026-05-22T10:01:00+00:00\",\n    \"updated_at\": \"2026-05-22T10:01:00+00:00\"\n  }\n}"
            },
            {
              "name": "400 Bad Request — missing field",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"value is required\"\n}"
            },
            {
              "name": "401 Unauthorized — missing token",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Missing or invalid Authorization header\"\n}"
            }
          ]
        },
        {
          "name": "List Secrets",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/secrets",
              "host": ["{{base_url}}"],
              "path": ["secrets"]
            },
            "description": "Return metadata for all secrets owned by the authenticated user.\n\nSecret values are **never** included in the list response."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"secrets\": [\n    {\n      \"id\": \"f7e6d5c4-0000-0000-0000-000000000002\",\n      \"owner_id\": \"a1b2c3d4-0000-0000-0000-000000000001\",\n      \"name\": \"STRIPE_API_KEY\",\n      \"description\": \"Production Stripe secret key\",\n      \"tags\": [\"payments\", \"production\"],\n      \"created_at\": \"2026-05-22T10:01:00+00:00\",\n      \"updated_at\": \"2026-05-22T10:01:00+00:00\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Retrieve a Secret",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/secrets/{{secret_id}}",
              "host": ["{{base_url}}"],
              "path": ["secrets", "{{secret_id}}"]
            },
            "description": "Fetch and decrypt a single secret by ID.\n\nOnly the owner may retrieve it — any other authenticated user receives 404."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"id\": \"f7e6d5c4-0000-0000-0000-000000000002\",\n  \"name\": \"STRIPE_API_KEY\",\n  \"value\": \"sk_live_abc123xyz\",\n  \"description\": \"Production Stripe secret key\",\n  \"tags\": [\"payments\", \"production\"],\n  \"created_at\": \"2026-05-22T10:01:00+00:00\",\n  \"updated_at\": \"2026-05-22T10:01:00+00:00\"\n}"
            },
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Secret not found\"\n}"
            }
          ]
        },
        {
          "name": "Update Secret Metadata",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/secrets/{{secret_id}}",
              "host": ["{{base_url}}"],
              "path": ["secrets", "{{secret_id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"STRIPE_API_KEY\",\n  \"description\": \"Production Stripe key (rotate by 2026-12-01)\",\n  \"tags\": [\"payments\", \"production\", \"rotate\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Update a secret's `name`, `description`, and/or `tags`.\n\nAll three fields are optional — send only the ones you want to change. The encrypted `value` is not affected."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Secret updated\",\n  \"secret\": {\n    \"id\": \"f7e6d5c4-0000-0000-0000-000000000002\",\n    \"owner_id\": \"a1b2c3d4-0000-0000-0000-000000000001\",\n    \"name\": \"STRIPE_API_KEY\",\n    \"description\": \"Production Stripe key (rotate by 2026-12-01)\",\n    \"tags\": [\"payments\", \"production\", \"rotate\"],\n    \"created_at\": \"2026-05-22T10:01:00+00:00\",\n    \"updated_at\": \"2026-05-22T10:05:00+00:00\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Delete a Secret",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/secrets/{{secret_id}}",
              "host": ["{{base_url}}"],
              "path": ["secrets", "{{secret_id}}"]
            },
            "description": "Permanently delete a secret. The underlying file is removed from disk immediately.\n\nAny outstanding share tokens for this secret will return 404 on access."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Secret deleted\"\n}"
            },
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Secret not found\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Sharing",
      "description": "Generate one-time expiring share tokens and access shared secrets without authentication.",
      "item": [
        {
          "name": "Generate Share Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('share_token', json.token);",
                  "    console.log('share_token saved: ' + json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/secrets/{{secret_id}}/share",
              "host": ["{{base_url}}"],
              "path": ["secrets", "{{secret_id}}", "share"]
            },
            "description": "Generate a cryptographically random one-time token for the specified secret.\n\nThe token expires after `SHARE_TOKEN_EXPIRY_MINUTES` (default: 60 minutes). It can only be used **once** — it is invalidated immediately on first access.\n\nThe Tests script saves the token to the `share_token` collection variable."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"token\": \"X9zQ2mR7kLpN4vT8wYsA1bDcEfGhIjKl\",\n  \"expires_at\": \"2026-05-22T11:01:00+00:00\"\n}"
            }
          ]
        },
        {
          "name": "Access via Share Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/share/{{share_token}}",
              "host": ["{{base_url}}"],
              "path": ["share", "{{share_token}}"]
            },
            "description": "Retrieve and decrypt a secret using a one-time share token. **No JWT required.**\n\nThe token is consumed on first use — any subsequent request with the same token returns `410 Gone`. An expired token also returns `410 Gone`."
          },
          "response": [
            {
              "name": "200 OK — first use",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"name\": \"STRIPE_API_KEY\",\n  \"value\": \"sk_live_abc123xyz\",\n  \"description\": \"Production Stripe secret key\"\n}"
            },
            {
              "name": "410 Gone — token already used",
              "status": "Gone",
              "code": 410,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Token has already been used\"\n}"
            },
            {
              "name": "410 Gone — token expired",
              "status": "Gone",
              "code": 410,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Token has expired\"\n}"
            },
            {
              "name": "404 Not Found — invalid token",
              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Invalid or expired token\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
